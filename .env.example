# ==============================================================================
# GATHR PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and populate with your production or sandbox credentials
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
APP_URL=https://letusgather.online
ALLOWED_ORIGINS=https://letusgather.online,https://gathr.app

# PostgreSQL Database (Supabase / Neon / AWS RDS)
DATABASE_URL=postgresql://gathr_user:YOUR_DB_PASSWORD@localhost:5432/gathr_db?sslmode=require
DB_POOL_MIN=2
DB_POOL_MAX=20

# Paystack Payments (Nigeria & West Africa Launch)
# Get keys at: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Payments (Global Card & International Expansion)
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meta WhatsApp Cloud API (Automated Ticket Bot Delivery)
# Setup at: https://developers.facebook.com/apps/
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=109283746592837
WHATSAPP_BUSINESS_ACCOUNT_ID=982736451928374
WHATSAPP_VERIFY_TOKEN=gathr_webhook_verify_token_secure_xyz

# Security & Ticket Token Encryption
JWT_SECRET=super_secret_jwt_signing_key_at_least_64_characters_long_here
TOTP_ENCRYPTION_SALT=gathr_totp_rolling_salt_for_dynamic_qr_encryption_2026
ADMIN_MASTER_KEY=gathr_platform_super_admin_secret_key_change_me
