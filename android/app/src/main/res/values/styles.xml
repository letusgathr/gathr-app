<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme styled to GATHR cinematic dark palette -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#FF5500</item>
        <item name="colorPrimaryDark">#090A0F</item>
        <item name="colorAccent">#FF5500</item>
        <item name="android:windowBackground">#090A0F</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#090A0F</item>
        <item name="android:statusBarColor">#090A0F</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:background">#090A0F</item>
    </style>
</resources>
